#!/usr/bin/env bash
set -uo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
ghostty_config="$project_dir/tests/ghostty.config"
tag="$$"
original_window="$(niri msg --json focused-window | jq -r '.id // empty')"

for command in ghostty jq niri niri-zvim nvim systemctl zellij; do
  command -v "$command" >/dev/null || {
    echo "$command is required" >&2
    exit 1
  }
done
systemctl --user is-active --quiet niri-zvim.service || {
  echo "niri-zvim.service is not active" >&2
  exit 1
}
if [[ -z "$original_window" ]]; then
  echo "focus a normal Niri window before running this test (not a layer-shell surface)" >&2
  exit 1
fi

restore_focus() {
  niri msg action focus-window --id "$original_window" >/dev/null 2>&1 || true
}
trap restore_focus EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

launch_ghostty() {
  ghostty +new-window \
    --config-default-files=false \
    --config-file="$ghostty_config" \
    -e "$@"
}

wait_for_socket() {
  local socket="$1"
  for _ in {1..100}; do
    [[ -S "$socket" ]] && return 0
    sleep 0.05
  done
  echo "timed out waiting for socket $socket" >&2
  return 1
}

wait_for_window() {
  local title="$1"
  local mode="$2"
  local window
  for _ in {1..100}; do
    if [[ "$mode" == exact ]]; then
      window="$(niri msg --json windows | jq -r --arg title "$title" \
        '.[] | select(.title == $title) | .id' | tail -1)"
    else
      window="$(niri msg --json windows | jq -r --arg title "$title" \
        '.[] | select(.title | contains($title)) | .id' | tail -1)"
    fi
    if [[ -n "$window" ]]; then
      printf '%s\n' "$window"
      return 0
    fi
    sleep 0.05
  done
  echo "timed out waiting for window $title" >&2
  return 1
}

wait_for_nvim_window() {
  local socket="$1"
  local expected="$2"
  local current
  for _ in {1..100}; do
    current="$(nvim_remote_expr "$socket" 'win_getid()')"
    [[ "$current" == "$expected" ]] && return 0
    sleep 0.02
  done
  echo "Neovim focused window did not become $expected" >&2
  return 1
}

wait_for_niri_window() {
  local expected="$1"
  for _ in {1..100}; do
    niri msg action focus-window --id "$expected" >/dev/null
    if [[ "$(niri msg --json focused-window | jq -r '.id // empty')" == "$expected" ]]; then
      return 0
    fi
    sleep 0.02
  done
  echo "Niri focused window did not become $expected" >&2
  return 1
}

wait_for_window_gone() {
  local window="$1"
  for _ in {1..100}; do
    if ! niri msg --json windows | jq -e --argjson id "$window" \
      '.[] | select(.id == $id)' >/dev/null; then
      return 0
    fi
    sleep 0.05
  done
  echo "timed out waiting for Niri window $window to close" >&2
  return 1
}

nvim_remote_expr() {
  local socket="$1"
  local expression="$2"
  nvim --headless --server "$socket" --remote-expr "$expression"
}

focused_zellij_pane() {
  local session="$1"
  zellij --session "$session" action list-panes --all --json |
    jq -r '.[] | select((.is_plugin | not) and .is_focused) | .id'
}

wait_for_zellij_session() {
  local session="$1"
  for _ in {1..100}; do
    zellij list-sessions --short --no-formatting 2>/dev/null |
      grep -qx "$session" && return 0
    sleep 0.05
  done
  echo "timed out waiting for Zellij session $session" >&2
  return 1
}

wait_for_zellij_pane() {
  local session="$1"
  local expected="$2"
  for _ in {1..100}; do
    [[ "$(focused_zellij_pane "$session")" == "$expected" ]] && return 0
    sleep 0.02
  done
  echo "Zellij focused pane did not become $expected" >&2
  return 1
}

test_direct_nvim() (
  set -euo pipefail
  local socket="$runtime_dir/niri-zvim-live-nvim-$tag.sock"
  local title="niri-zvim-live-nvim-$tag"
  local window=""

  cleanup() {
    if [[ -S "$socket" ]]; then
      nvim_remote_expr "$socket" 'execute("qa!")' >/dev/null 2>&1 || true
    fi
    if [[ -n "$window" ]]; then
      wait_for_window_gone "$window" || true
    fi
  }
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  launch_ghostty nvim \
    --listen "$socket" \
    --cmd "set title titlestring=$title" \
    -c vsplit
  wait_for_socket "$socket"
  window="$(wait_for_window "$title" exact)"
  wait_for_niri_window "$window"
  sleep 0.1
  nvim_remote_expr "$socket" 'execute("wincmd l")' >/dev/null
  sleep 0.1

  local right left
  right="$(nvim_remote_expr "$socket" 'win_getid()')"
  niri-zvim left
  for _ in {1..100}; do
    left="$(nvim_remote_expr "$socket" 'win_getid()')"
    [[ "$left" != "$right" ]] && break
    sleep 0.02
  done
  [[ "$left" != "$right" ]] || {
    echo "Neovim did not move left" >&2
    return 1
  }
  [[ "$(niri msg --json focused-window | jq -r '.id // empty')" == "$window" ]] || {
    echo "Niri left the direct Neovim window" >&2
    return 1
  }
  niri-zvim right
  wait_for_nvim_window "$socket" "$right"
  printf '  windows %s -> %s -> %s; Niri stayed on window %s\n' \
    "$right" "$left" "$right" "$window"
)

test_zellij_panes() (
  set -euo pipefail
  local session="niri-zvim-live-zellij-$tag"
  local window=""

  cleanup() {
    zellij kill-session "$session" >/dev/null 2>&1 || true
    zellij delete-session "$session" --force >/dev/null 2>&1 || true
    if [[ -n "$window" ]]; then
      wait_for_window_gone "$window" || true
    fi
  }
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  launch_ghostty zellij --session "$session"
  wait_for_zellij_session "$session"
  window="$(wait_for_window "$session" contains)"
  sleep 0.5
  zellij --session "$session" action new-pane --direction right >/dev/null
  sleep 0.3
  wait_for_niri_window "$window"
  sleep 0.1

  local right left
  right="$(focused_zellij_pane "$session")"
  niri-zvim left
  for _ in {1..100}; do
    left="$(focused_zellij_pane "$session")"
    [[ "$left" != "$right" ]] && break
    sleep 0.02
  done
  [[ "$left" != "$right" ]] || {
    echo "Zellij did not move left" >&2
    return 1
  }
  niri-zvim right
  wait_for_zellij_pane "$session" "$right"
  [[ "$(niri msg --json focused-window | jq -r '.id // empty')" == "$window" ]] || {
    echo "Niri left the Zellij window" >&2
    return 1
  }
  printf '  panes %s -> %s -> %s; Niri stayed on window %s\n' \
    "$right" "$left" "$right" "$window"
)

failures=()
run_case() {
  local name="$1"
  local function="$2"
  printf '\n-- %s --\n' "$name"
  if "$function"; then
    printf 'PASS: %s\n' "$name"
  else
    failures+=("$name")
    printf 'FAIL: %s\n' "$name" >&2
  fi
}

cat <<'EOF'
This test opens and focuses disposable Ghostty windows.
Do not use the mouse or keyboard until the final PASS/FAIL summary appears;
changing focus while the test runs can produce incorrect results.
EOF

run_case "direct Neovim navigation" test_direct_nvim
run_case "Zellij pane navigation" test_zellij_panes

printf '\n'
if ((${#failures[@]})); then
  echo "Live tests failed:"
  printf '  - %s\n' "${failures[@]}"
  exit 1
fi
echo "All live navigation tests passed."
