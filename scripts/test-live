#!/usr/bin/env bash
set -uo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
live_tests_dir="$project_dir/scripts/live-tests"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
daemon_config="${NIRI_ZVIM_CONFIG:-$config_home/niri-zvim/config.json}"
ghostty_config="$project_dir/tests/ghostty.config"
terminal_fixture="$project_dir/tests/fixtures/terminal"
warning_fixture="$project_dir/tests/fixtures/warning"
nvim_fixture="$project_dir/tests/fixtures/nvim.lua"
tag="$$"
zellij_cache_home="$runtime_dir/niri-zvim-live-$tag-cache"
operation_timeout_seconds=3
case_timeout_seconds="${NIRI_ZVIM_LIVE_TIMEOUT:-20}"
selected_case="${1:-all}"
case_state_file="$runtime_dir/niri-zvim-live-$tag.state"
case_debug_file="$runtime_dir/niri-zvim-live-$tag.debug"
case_interruption_file="$runtime_dir/niri-zvim-live-$tag.interrupted"
warning_pid_file="$runtime_dir/niri-zvim-live-$tag-warning.pid"
# shellcheck source=scripts/test-output
source "$project_dir/scripts/test-output"

if (($# > 1)); then
  echo "usage: scripts/test-live [all|terminals|terminal-alacritty|terminal-kitty|terminal-foot|terminal-wezterm|direct|tabs|zellij-one|zellij-three|zellij-multi|discovery|nested|consumed|consumed-zellij|consumed-reflow|consumed-nvim|workspaces]" >&2
  exit 2
fi
case "$selected_case" in
  all | terminals | terminal-alacritty | terminal-kitty | terminal-foot | terminal-wezterm | direct | tabs | zellij-one | zellij-three | zellij-multi | discovery | nested | consumed | consumed-zellij | consumed-reflow | consumed-nvim | workspaces) ;;
  *)
    echo "unknown live test case: $selected_case" >&2
    exit 2
    ;;
esac

for command in getconf ghostty jq niri niri-zvim nvim pkill systemctl timeout zellij; do
  command -v "$command" >/dev/null || {
    echo "$command is required" >&2
    exit 1
  }
done
if [[ ! "$case_timeout_seconds" =~ ^[1-9][0-9]*$ ]]; then
  echo "NIRI_ZVIM_LIVE_TIMEOUT must be a positive integer" >&2
  exit 1
fi
systemctl --user is-active --quiet niri-zvim.service || {
  echo "niri-zvim.service is not active" >&2
  exit 1
}
if [[ ! -r "$daemon_config" ]]; then
  echo "the workspace live test requires a readable daemon config at $daemon_config" >&2
  exit 1
fi
active_up="$(jq -r '.modes[.active_mode].up // empty' "$daemon_config")"
active_down="$(jq -r '.modes[.active_mode].down // empty' "$daemon_config")"
if [[ "$active_up" != focus-window-or-workspace-up ||
  "$active_down" != focus-window-or-workspace-down ]]; then
  echo "the active daemon mode must use workspace-aware up/down navigation" >&2
  exit 1
fi

original_window="$(niri msg --json focused-window | jq -r '.id // empty')"
if [[ -z "$original_window" ]]; then
  echo "focus a normal Niri window before running this test (not a layer-shell surface)" >&2
  exit 1
fi
original_windows="$(niri msg --json windows)"
original_workspaces="$(niri msg --json workspaces)"

zellij_plugin="${NIRI_ZVIM_ZELLIJ_PLUGIN:-$config_home/zellij/plugins/niri-zvim.wasm}"
zellij_permission_dir="$zellij_cache_home/zellij"
zellij_version="$(zellij --version | awk '{print $2}')"
daemon_pid="$(systemctl --user show --property MainPID --value niri-zvim.service)"
daemon_cache_home="$(tr '\0' '\n' <"/proc/$daemon_pid/environ" |
  sed -n 's/^XDG_CACHE_HOME=//p' | tail -n 1)"
if [[ -z "$daemon_cache_home" ]]; then
  daemon_home="$(tr '\0' '\n' <"/proc/$daemon_pid/environ" |
    sed -n 's/^HOME=//p' | tail -n 1)"
  daemon_cache_home="${daemon_home:-$HOME}/.cache"
fi
daemon_session_info="$daemon_cache_home/zellij/contract_version_1/session_info"
zellij_session_parent="$zellij_cache_home/zellij/contract_version_1"
mkdir -p "$zellij_permission_dir/$zellij_version" "$daemon_session_info" \
  "$zellij_session_parent"
ln -s "$daemon_session_info" "$zellij_session_parent/session_info"
: >"$zellij_permission_dir/$zellij_version/seen_release_notes"
quoted_plugin_path="$(jq -Rn --arg value "$zellij_plugin" '$value')"
{
  printf '%s {\n' "$quoted_plugin_path"
  printf '    ReadApplicationState\n'
  printf '    ChangeApplicationState\n'
  printf '    ReadCliPipes\n'
  printf '    ReadSessionEnvironmentVariables\n'
  printf '}\n'
} >"$zellij_permission_dir/permissions.kdl"

# shellcheck source=scripts/live-tests/common.sh
source "$live_tests_dir/common.sh"
# shellcheck source=scripts/live-tests/direct.sh
source "$live_tests_dir/direct.sh"
# shellcheck source=scripts/live-tests/tabs.sh
source "$live_tests_dir/tabs.sh"
# shellcheck source=scripts/live-tests/zellij-one.sh
source "$live_tests_dir/zellij-one.sh"
# shellcheck source=scripts/live-tests/zellij-three.sh
source "$live_tests_dir/zellij-three.sh"
# shellcheck source=scripts/live-tests/zellij-multi.sh
source "$live_tests_dir/zellij-multi.sh"
# shellcheck source=scripts/live-tests/discovery.sh
source "$live_tests_dir/discovery.sh"
# shellcheck source=scripts/live-tests/terminal-smoke.sh
source "$live_tests_dir/terminal-smoke.sh"
# shellcheck source=scripts/live-tests/nested.sh
source "$live_tests_dir/nested.sh"
# shellcheck source=scripts/live-tests/consumed-zellij.sh
source "$live_tests_dir/consumed-zellij.sh"
# shellcheck source=scripts/live-tests/consumed-reflow.sh
source "$live_tests_dir/consumed-reflow.sh"
# shellcheck source=scripts/live-tests/consumed-nvim.sh
source "$live_tests_dir/consumed-nvim.sh"
# shellcheck source=scripts/live-tests/workspaces.sh
source "$live_tests_dir/workspaces.sh"
# shellcheck source=scripts/live-tests/preservation.sh
source "$live_tests_dir/preservation.sh"
test_cpu_count="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo unknown)"
test_start_cpu_strain="$(cpu_strain_snapshot)"

restore_focus() {
  if [[ -s "$warning_pid_file" ]]; then
    kill "$(<"$warning_pid_file")" >/dev/null 2>&1 || true
  fi
  niri msg action focus-window --id "$original_window" >/dev/null 2>&1 || true
  rm -f "$case_state_file" "$case_debug_file" "$case_interruption_file" \
    "$warning_pid_file"
  rm -rf "$zellij_cache_home"
}
trap restore_focus EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

while read -r _ _ function; do
  export -f "${function?}"
done < <(declare -F)
export project_dir runtime_dir daemon_config ghostty_config terminal_fixture nvim_fixture tag
export zellij_cache_home zellij_plugin
export operation_timeout_seconds case_state_file case_debug_file case_interruption_file
export original_window original_windows original_workspaces
export test_cpu_count test_start_cpu_strain
export TEST_RED TEST_GREEN TEST_YELLOW TEST_RESET

show_live_warning() {
  local title="niri-zvim-live-$tag-warning"
  local window pid
  timeout --signal=TERM --kill-after=2s "${operation_timeout_seconds}s" \
    ghostty +new-window \
    --config-default-files=false \
    --config-file="$ghostty_config" \
    --font-size=18 \
    --window-width=68 \
    --window-height=7 \
    -e "$warning_fixture" "$title" "$warning_pid_file"
  wait_for_file "$warning_pid_file"
  window="$(wait_for_window "$title" exact)"
  focus_niri_window "$window"
  niri msg action move-window-to-floating >/dev/null
  niri msg action center-window >/dev/null
  sleep 2
  pid="$(<"$warning_pid_file")"
  kill "$pid" >/dev/null 2>&1 || true
  wait_for_windows_gone "$window"
  focus_niri_window "$original_window"
  rm -f "$warning_pid_file"
}

show_live_warning

cat <<'EOF'
This test opens and focuses disposable Ghostty windows and creates temporary
named Niri workspaces. Do not use the mouse or keyboard until the final
PASS/FAIL summary appears; changing focus can produce incorrect results.
Only test processes and test workspace names are removed during cleanup.
EOF
printf 'Each operation has a 3-second deadline; each complete case has a %s-second safety cap.\n' \
  "$case_timeout_seconds"
echo "Failures print a serialized state snapshot before the next case starts."

if [[ "$selected_case" == all || "$selected_case" == direct ]]; then
  run_case "empty terminals and direct Neovim matrix" test_direct_terminal_matrix
fi
if [[ "$selected_case" == all || "$selected_case" == tabs ]]; then
  run_case "Niri tabbed column traversal" test_niri_tabbed_column
fi
if [[ "$selected_case" == all || "$selected_case" == zellij-one ]]; then
  run_case "single-pane Zellij boundaries" test_zellij_single_pane
fi
if [[ "$selected_case" == all || "$selected_case" == zellij-three ]]; then
  run_case "three-pane Zellij traversal" test_zellij_three_panes
fi
if [[ "$selected_case" == all || "$selected_case" == zellij-multi ]]; then
  run_case "multiple attached Zellij clients" test_zellij_multiple_clients
fi
if [[ "$selected_case" == all || "$selected_case" == discovery ]]; then
  run_case "configuration reload and terminal discovery" test_configured_terminal_discovery
fi
for terminal in alacritty kitty foot wezterm; do
  if [[ "$selected_case" != all && "$selected_case" != terminals &&
    "$selected_case" != "terminal-$terminal" ]]; then
    continue
  fi
  terminal_binary="$(terminal_command "$terminal")"
  if ! command -v "$terminal_binary" >/dev/null; then
    test_skip "$terminal navigation smoke ($terminal_binary is not installed)"
    continue
  fi
  run_case "$terminal Zellij navigation smoke" \
    "test_terminal_navigation_smoke $terminal"
done
if [[ "$selected_case" == all || "$selected_case" == nested ]]; then
  run_case "nested Neovim in Zellij traversal" test_nested_nvim_in_zellij
fi
if [[ "$selected_case" == all || "$selected_case" == consumed ||
  "$selected_case" == consumed-zellij ]]; then
  run_case "consumed Zellij column traversal" test_consumed_zellij_columns
fi
if [[ "$selected_case" == all || "$selected_case" == consumed ||
  "$selected_case" == consumed-reflow ]]; then
  run_case "consumed Zellij resize reflow" test_consumed_zellij_resize_reflow
fi
if [[ "$selected_case" == all || "$selected_case" == consumed ||
  "$selected_case" == consumed-nvim ]]; then
  run_case "consumed direct and nested Neovim traversal" test_consumed_nvim_columns
fi
if [[ "$selected_case" == all || "$selected_case" == workspaces ]]; then
  run_case "workspace up/down traversal" test_workspace_navigation
fi
run_case "original desktop preservation" test_original_desktop_preserved

printf '\n'
if ((${#interruptions[@]})); then
  test_interrupted "Live tests were interrupted by external focus changes"
  printf '  - %s\n' "${interruptions[@]}" >&2
  exit 2
fi
if ((${#failures[@]})); then
  test_failure_heading "Live tests failed:"
  printf '  - %s\n' "${failures[@]}"
  exit 1
fi
test_success "All live navigation tests passed."
