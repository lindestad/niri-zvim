#!/usr/bin/env bash
# Variables and assignments below are consumed by sourced live-test helpers.
# shellcheck disable=SC1091,SC2030,SC2031,SC2034,SC2154
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
live_tests_dir="$project_dir/scripts/live-tests"
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
ghostty_config="$project_dir/tests/ghostty.config"
terminal_fixture="$project_dir/tests/fixtures/terminal"
warning_fixture="$project_dir/tests/fixtures/warning"
nvim_fixture="$project_dir/tests/fixtures/nvim.lua"
sample_bin="$project_dir/target/release/live-bench-sample"
client_bin="$project_dir/target/release/niri-zvim"
vim_niri_nav_dir="${VIM_NIRI_NAV_DIR:-$project_dir/../vim-niri-nav}"
vim_niri_nav_script="$vim_niri_nav_dir/vim-niri-nav"
vim_niri_nav_plugin="$vim_niri_nav_dir/plugin/vim-niri-nav.vim"
vim_niri_nav_commit=""
vim_niri_nav_unavailable=""
tag="bench-$$"
operation_timeout_seconds=3
case_timeout_seconds=60
case_state_file="$runtime_dir/niri-zvim-live-$tag.state"
case_debug_file="$runtime_dir/niri-zvim-live-$tag.debug"
warning_pid_file="$runtime_dir/niri-zvim-live-$tag-warning.pid"
samples="${NIRI_ZVIM_BENCH_SAMPLES:-12}"
burst_samples="${NIRI_ZVIM_BENCH_BURSTS:-6}"
selected_backend="${1:-all}"

if (($# > 1)) || [[ ! "$selected_backend" =~ ^(all|niri|zellij|nvim|vim-niri-nav)$ ]]; then
  echo "usage: scripts/bench-live [all|niri|zellij|nvim|vim-niri-nav]" >&2
  exit 2
fi

# shellcheck source=scripts/test-output
source "$project_dir/scripts/test-output"

for command in awk cargo getconf ghostty jq niri nvim seq sort systemctl timeout zellij; do
  command -v "$command" >/dev/null || {
    echo "$command is required" >&2
    exit 1
  }
done
[[ "$samples" =~ ^[1-9][0-9]*$ && "$burst_samples" =~ ^[1-9][0-9]*$ ]] || {
  echo "benchmark sample counts must be positive integers" >&2
  exit 1
}
systemctl --user is-active --quiet niri-zvim.service || {
  echo "niri-zvim.service is not active" >&2
  exit 1
}

if ! command -v git >/dev/null; then
  vim_niri_nav_unavailable="git is not installed"
elif ! command -v alacritty >/dev/null; then
  vim_niri_nav_unavailable="alacritty is not installed"
elif [[ ! -x "$vim_niri_nav_script" ]]; then
  vim_niri_nav_unavailable="$vim_niri_nav_script is not executable"
elif [[ ! -r "$vim_niri_nav_plugin" ]]; then
  vim_niri_nav_unavailable="$vim_niri_nav_plugin is not readable"
elif ! vim_niri_nav_commit="$(git -C "$vim_niri_nav_dir" rev-parse HEAD 2>/dev/null)"; then
  vim_niri_nav_unavailable="$vim_niri_nav_dir is not a Git checkout"
elif [[ -n "$(git -C "$vim_niri_nav_dir" status --porcelain)" ]]; then
  vim_niri_nav_unavailable="$vim_niri_nav_dir has uncommitted changes"
fi
if [[ "$selected_backend" == vim-niri-nav && -n "$vim_niri_nav_unavailable" ]]; then
  echo "cannot run vim-niri-nav comparison: $vim_niri_nav_unavailable" >&2
  exit 1
fi

if command -v loginctl >/dev/null && [[ -n "${XDG_SESSION_ID:-}" ]] &&
  [[ "$(loginctl show-session "$XDG_SESSION_ID" --property LockedHint --value 2>/dev/null)" == yes ]]; then
  echo "the desktop session is locked; unlock it before running this benchmark" >&2
  exit 1
fi
original_window="$(niri msg --json focused-window | jq -r '.id // empty')"
if [[ -z "$original_window" ]]; then
  echo "focus a normal Niri window before running this benchmark" >&2
  exit 1
fi
original_windows="$(niri msg --json windows)"
original_workspaces="$(niri msg --json workspaces)"
test_cpu_count="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo unknown)"

# shellcheck source=scripts/live-tests/common.sh
source "$live_tests_dir/common.sh"
# shellcheck source=scripts/live-tests/preservation.sh
source "$live_tests_dir/preservation.sh"
test_start_cpu_strain="$(cpu_strain_snapshot)"

restore_focus() {
  if [[ -s "$warning_pid_file" ]]; then
    kill "$(<"$warning_pid_file")" >/dev/null 2>&1 || true
  fi
  niri msg action focus-window --id "$original_window" >/dev/null 2>&1 || true
  rm -f "$case_state_file" "$case_debug_file" "$warning_pid_file"
}
finish() {
  local status="$?"
  restore_focus
  if ((status != 0)); then
    printf '\nCPU strain at failure: start=%s end=' "$test_start_cpu_strain" >&2
    cpu_strain_snapshot >&2
    printf '\n' >&2
  fi
  return "$status"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

show_live_warning() {
  local title="niri-zvim-live-$tag-warning"
  local window pid
  timeout --signal=TERM --kill-after=2s "${operation_timeout_seconds}s" \
    ghostty +new-window \
    --config-default-files=false \
    --config-file="$ghostty_config" \
    --font-size=18 \
    --window-width=68 \
    --window-height=7 \
    -e "$warning_fixture" "$title" "$warning_pid_file" \
    "NIRI-ZVIM LIVE BENCHMARK"
  wait_for_file "$warning_pid_file"
  window="$(wait_for_window "$title" exact)"
  focus_niri_window "$window"
  niri msg action move-window-to-floating --id "$window" >/dev/null
  niri msg action center-window --id "$window" >/dev/null
  sleep 2
  pid="$(<"$warning_pid_file")"
  kill "$pid" >/dev/null 2>&1 || true
  wait_for_windows_gone "$window"
  focus_niri_window "$original_window"
  rm -f "$warning_pid_file"
}

report_series() {
  local label="$1"
  shift
  local -a sorted
  mapfile -t sorted < <(printf '%s\n' "$@" | sort -n)
  local count="${#sorted[@]}"
  local p50="${sorted[$(((count - 1) * 50 / 100))]}"
  local p95="${sorted[$(((count - 1) * 95 / 100))]}"
  local p99="${sorted[$(((count - 1) * 99 / 100))]}"
  local max="${sorted[$((count - 1))]}"
  local mean
  mean="$(printf '%s\n' "$@" | awk '{ total += $1 } END { printf "%.0f", total / NR }')"
  printf '  %-30s mean=%7.3fms p50=%7.3fms p95=%7.3fms p99=%7.3fms max=%7.3fms\n' \
    "$label" \
    "$(awk -v n="$mean" 'BEGIN { print n / 1000000 }')" \
    "$(awk -v n="$p50" 'BEGIN { print n / 1000000 }')" \
    "$(awk -v n="$p95" 'BEGIN { print n / 1000000 }')" \
    "$(awk -v n="$p99" 'BEGIN { print n / 1000000 }')" \
    "$(awk -v n="$max" 'BEGIN { print n / 1000000 }')"
}

measure() {
  local backend="$1" mode="$2" direction="$3" expected="$4" count="${5:-1}"
  NIRI_ZVIM_CLIENT="$client_bin" "$sample_bin" \
    "$backend" "$mode" "$direction" "$expected" "$count"
}

report_comparison() {
  local backend="$1"
  local -n native_dispatch_ref="$2" native_total_ref="$3"
  local -n daemon_dispatch_ref="$4" daemon_total_ref="$5"
  local -n native_burst_ref="$6" daemon_burst_ref="$7"
  printf '\n%s\n' "$backend"
  report_series "native trigger completion" "${native_dispatch_ref[@]}"
  report_series "native observed focus" "${native_total_ref[@]}"
  report_series "daemon trigger completion" "${daemon_dispatch_ref[@]}"
  report_series "daemon observed focus" "${daemon_total_ref[@]}"
  report_series "native 2-step convergence" "${native_burst_ref[@]}"
  report_series "daemon 2-step convergence" "${daemon_burst_ref[@]}"
}

report_nvim_implementation_comparison() {
  local -n native_dispatch_ref="$1" native_total_ref="$2"
  local -n competitor_dispatch_ref="$3" competitor_total_ref="$4"
  local -n daemon_dispatch_ref="$5" daemon_total_ref="$6"
  local -n native_burst_ref="$7" competitor_burst_ref="$8" daemon_burst_ref="$9"
  printf '\nNeovim implementation comparison (Alacritty)\n'
  printf '  vim-niri-nav commit: %s\n' "$vim_niri_nav_commit"
  report_series "native trigger completion" "${native_dispatch_ref[@]}"
  report_series "native observed focus" "${native_total_ref[@]}"
  report_series "vim-niri-nav trigger completion" "${competitor_dispatch_ref[@]}"
  report_series "vim-niri-nav observed focus" "${competitor_total_ref[@]}"
  report_series "niri-zvim trigger completion" "${daemon_dispatch_ref[@]}"
  report_series "niri-zvim observed focus" "${daemon_total_ref[@]}"
  report_series "native 2-step convergence" "${native_burst_ref[@]}"
  report_series "vim-niri-nav 2-step convergence" "${competitor_burst_ref[@]}"
  report_series "niri-zvim 2-step convergence" "${daemon_burst_ref[@]}"
}

bench_niri() (
  local -a test_windows nvim_sockets zellij_sessions terminal_pid_files test_workspaces
  local -a nd nt dd dt nb db
  begin_case
  local prefix="niri-zvim-live-$tag-bench-niri"
  local workspace="$prefix-workspace"
  local left_pid="$runtime_dir/$prefix-left.pid"
  local middle_pid="$runtime_dir/$prefix-middle.pid"
  local right_pid="$runtime_dir/$prefix-right.pid"
  terminal_pid_files+=("$left_pid" "$middle_pid" "$right_pid")

  focus_fresh_workspace
  local left middle right dispatch total _
  launch_terminal "$prefix-left" "$left_pid"; left="$launched_window"; test_windows+=("$left")
  name_focused_workspace "$workspace"; test_workspaces+=("$workspace")
  move_window_column_last "$left"
  launch_terminal "$prefix-middle" "$middle_pid"; middle="$launched_window"; test_windows+=("$middle")
  move_window_column_last "$middle"
  launch_terminal "$prefix-right" "$right_pid"; right="$launched_window"; test_windows+=("$right")
  move_window_column_last "$right"

  for _ in $(seq 1 "$samples"); do
    focus_niri_window "$left"
    read -r dispatch total < <(measure niri native right "$middle")
    nd+=("$dispatch"); nt+=("$total")
    read -r dispatch total < <(measure niri native left "$left")
    nd+=("$dispatch"); nt+=("$total")
  done
  for _ in $(seq 1 "$samples"); do
    focus_niri_window "$left"
    read -r dispatch total < <(measure niri daemon right "$middle")
    dd+=("$dispatch"); dt+=("$total")
    read -r dispatch total < <(measure niri daemon left "$left")
    dd+=("$dispatch"); dt+=("$total")
  done
  for _ in $(seq 1 "$burst_samples"); do
    focus_niri_window "$left"
    read -r _ total < <(measure niri native right "$right" 2); nb+=("$total")
    focus_niri_window "$left"
    read -r _ total < <(measure niri daemon right "$right" 2); db+=("$total")
  done
  report_comparison "Niri columns" nd nt dd dt nb db
)

bench_zellij() (
  local -a test_windows nvim_sockets zellij_sessions terminal_pid_files test_workspaces
  local -a nd nt dd dt nb db
  begin_case
  local prefix="niri-zvim-live-$tag-bench-zellij"
  local workspace="$prefix-workspace"
  local native_session="$prefix-native-session"
  local daemon_session="$prefix-daemon-session"
  local layout='layout {
    pane split_direction="vertical" {
        pane focus=true
        pane
        pane
    }
}'
  zellij_sessions+=("$native_session" "$daemon_session")

  focus_fresh_workspace
  local native_window daemon_window dispatch total _
  # Keep native and daemon samples in equivalent but separate sessions so
  # out-of-band native focus changes cannot contaminate optimistic state.
  launch_zellij "$native_session" 3 "$layout"
  native_window="$launched_window"; test_windows+=("$native_window")
  name_focused_workspace "$workspace"; test_workspaces+=("$workspace")
  mapfile -t native_panes < <(zellij_pane_ids "$native_session")

  launch_zellij "$daemon_session" 3 "$layout"
  daemon_window="$launched_window"; test_windows+=("$daemon_window")
  mapfile -t daemon_panes < <(zellij_pane_ids "$daemon_session")

  focus_niri_window "$native_window"
  export NIRI_ZVIM_BENCH_SESSION="$native_session"
  for _ in $(seq 1 "$samples"); do
    read -r dispatch total < <(measure zellij native right "${native_panes[1]}")
    nd+=("$dispatch"); nt+=("$total")
    read -r dispatch total < <(measure zellij native left "${native_panes[0]}")
    nd+=("$dispatch"); nt+=("$total")
  done
  for _ in $(seq 1 "$burst_samples"); do
    read -r _ total < <(measure zellij native right "${native_panes[2]}" 2); nb+=("$total")
    measure zellij native left "${native_panes[0]}" 2 >/dev/null
  done

  focus_niri_window "$daemon_window"
  export NIRI_ZVIM_BENCH_SESSION="$daemon_session"
  for _ in $(seq 1 "$samples"); do
    read -r dispatch total < <(measure zellij daemon right "${daemon_panes[1]}")
    dd+=("$dispatch"); dt+=("$total")
    read -r dispatch total < <(measure zellij daemon left "${daemon_panes[0]}")
    dd+=("$dispatch"); dt+=("$total")
  done
  for _ in $(seq 1 "$burst_samples"); do
    read -r _ total < <(measure zellij daemon right "${daemon_panes[2]}" 2); db+=("$total")
    measure zellij daemon left "${daemon_panes[0]}" 2 >/dev/null
  done
  report_comparison "Zellij panes" nd nt dd dt nb db
)

bench_nvim() (
  local -a test_windows nvim_sockets zellij_sessions terminal_pid_files test_workspaces
  local -a windows nd nt dd dt nb db
  begin_case
  local prefix="niri-zvim-live-$tag-bench-nvim"
  local workspace="$prefix-workspace"
  local socket="$runtime_dir/$prefix.sock"
  nvim_sockets+=("$socket")

  focus_fresh_workspace
  local window dispatch total _
  launch_nvim "$prefix" "$socket" 3; window="$launched_window"; test_windows+=("$window")
  name_focused_workspace "$workspace"; test_workspaces+=("$workspace")
  mapfile -t windows < <(nvim_window_ids "$socket")
  focus_nvim_window "$socket" "${windows[0]}"
  export NIRI_ZVIM_BENCH_NVIM="$socket"

  for _ in $(seq 1 "$samples"); do
    focus_nvim_window "$socket" "${windows[0]}"
    read -r dispatch total < <(measure nvim native right "${windows[1]}")
    nd+=("$dispatch"); nt+=("$total")
    read -r dispatch total < <(measure nvim native left "${windows[0]}")
    nd+=("$dispatch"); nt+=("$total")
  done
  for _ in $(seq 1 "$samples"); do
    focus_nvim_window "$socket" "${windows[0]}"
    read -r dispatch total < <(measure nvim daemon right "${windows[1]}")
    dd+=("$dispatch"); dt+=("$total")
    read -r dispatch total < <(measure nvim daemon left "${windows[0]}")
    dd+=("$dispatch"); dt+=("$total")
  done
  for _ in $(seq 1 "$burst_samples"); do
    focus_nvim_window "$socket" "${windows[0]}"
    read -r _ total < <(measure nvim native right "${windows[2]}" 2); nb+=("$total")
    focus_nvim_window "$socket" "${windows[0]}"
    read -r _ total < <(measure nvim daemon right "${windows[2]}" 2); db+=("$total")
  done
  report_comparison "Neovim windows" nd nt dd dt nb db
)

bench_vim_niri_nav() (
  local -a test_windows nvim_sockets zellij_sessions terminal_pid_files test_workspaces
  local -a windows nd nt vd vt dd dt nb vb db
  begin_case
  local prefix="niri-zvim-live-$tag-bench-vim-niri-nav"
  local workspace="$prefix-workspace"
  local socket="$runtime_dir/$prefix.sock"
  nvim_sockets+=("$socket")

  focus_fresh_workspace
  launch_test_terminal alacritty env \
    NIRI_ZVIM_BENCH_VIM_PLUGIN="$vim_niri_nav_plugin" \
    nvim -u "$nvim_fixture" --noplugin --listen "$socket" \
    -c "set title titlestring=$prefix | set splitright | vsplit | vsplit"
  wait_for_socket "$socket"
  wait_for_nvim_count "$socket" 3
  local window dispatch total _
  window="$(wait_for_window "$prefix" exact)"
  test_windows+=("$window")
  name_focused_workspace "$workspace"
  test_workspaces+=("$workspace")
  mapfile -t windows < <(nvim_window_ids "$socket")
  focus_niri_window "$window"
  focus_nvim_window "$socket" "${windows[0]}"
  export NIRI_ZVIM_BENCH_NVIM="$socket"
  export NIRI_ZVIM_BENCH_VIM_NIRI_NAV="$vim_niri_nav_script"

  # Validate and warm the external implementation before collecting samples.
  measure nvim vim-niri-nav right "${windows[1]}" >/dev/null
  focus_nvim_window "$socket" "${windows[0]}"

  for _ in $(seq 1 "$samples"); do
    focus_nvim_window "$socket" "${windows[0]}"
    read -r dispatch total < <(measure nvim native right "${windows[1]}")
    nd+=("$dispatch"); nt+=("$total")
    read -r dispatch total < <(measure nvim native left "${windows[0]}")
    nd+=("$dispatch"); nt+=("$total")
  done
  for _ in $(seq 1 "$samples"); do
    focus_nvim_window "$socket" "${windows[0]}"
    read -r dispatch total < <(measure nvim vim-niri-nav right "${windows[1]}")
    vd+=("$dispatch"); vt+=("$total")
    read -r dispatch total < <(measure nvim vim-niri-nav left "${windows[0]}")
    vd+=("$dispatch"); vt+=("$total")
  done
  for _ in $(seq 1 "$samples"); do
    focus_nvim_window "$socket" "${windows[0]}"
    read -r dispatch total < <(measure nvim daemon right "${windows[1]}")
    dd+=("$dispatch"); dt+=("$total")
    read -r dispatch total < <(measure nvim daemon left "${windows[0]}")
    dd+=("$dispatch"); dt+=("$total")
  done
  for _ in $(seq 1 "$burst_samples"); do
    focus_nvim_window "$socket" "${windows[0]}"
    read -r _ total < <(measure nvim native right "${windows[2]}" 2); nb+=("$total")
    focus_nvim_window "$socket" "${windows[0]}"
    read -r _ total < <(measure nvim vim-niri-nav right "${windows[2]}" 2); vb+=("$total")
    focus_nvim_window "$socket" "${windows[0]}"
    read -r _ total < <(measure nvim daemon right "${windows[2]}" 2); db+=("$total")
  done
  report_nvim_implementation_comparison nd nt vd vt dd dt nb vb db
)

cat <<'EOF'
This benchmark opens disposable terminal windows and controls desktop focus.
Do not use the keyboard or mouse until the final CPU-strain summary appears.
Timings include trigger-process cost and authoritative polling overhead.
They are descriptive distributions, not correctness thresholds.
EOF
cargo build --quiet --release -p niri-zvim \
  --features live-bench --bin niri-zvim --bin live-bench-sample
show_live_warning
printf 'Starting with %s single samples and %s burst samples...\n' \
  "$samples" "$burst_samples"
if [[ "$selected_backend" == all || "$selected_backend" == niri ]]; then
  bench_niri
fi
if [[ "$selected_backend" == all || "$selected_backend" == zellij ]]; then
  bench_zellij
fi
if [[ "$selected_backend" == all || "$selected_backend" == nvim ]]; then
  bench_nvim
fi
if [[ "$selected_backend" == all || "$selected_backend" == nvim ||
  "$selected_backend" == vim-niri-nav ]]; then
  if [[ -n "$vim_niri_nav_unavailable" ]]; then
    test_skip "vim-niri-nav comparison ($vim_niri_nav_unavailable)"
  else
    bench_vim_niri_nav
  fi
fi
test_original_desktop_preserved

printf '\nCPU strain: start=%s end=' "$test_start_cpu_strain"
cpu_strain_snapshot
printf '\n'
