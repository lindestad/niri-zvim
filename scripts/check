#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_dir"

for command in cargo git shellcheck; do
  command -v "$command" >/dev/null || {
    echo "$command is required" >&2
    exit 1
  }
done

cargo fmt --all -- --check
cargo test --workspace --all-features --locked
cargo clippy --workspace --all-targets --all-features \
  --exclude niri-zvim-zellij --locked -- -D warnings
cargo clippy --package niri-zvim-zellij --target wasm32-wasip1 \
  --locked -- -D warnings

shellcheck -x \
  scripts/bench \
  scripts/bench-live \
  scripts/check \
  scripts/install \
  scripts/test \
  scripts/test-live \
  scripts/test-output \
  tests/fixtures/terminal

package_flags=()
if [[ -n "$(git status --porcelain)" ]]; then
  package_flags+=(--allow-dirty)
fi
cargo package --workspace --exclude niri-zvim-zellij --locked \
  "${package_flags[@]}"
