#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_dir"

for command in cargo git nvim shellcheck; do
  command -v "$command" >/dev/null || {
    echo "$command is required" >&2
    exit 1
  }
done

cargo fmt --all -- --check
cargo test --workspace --all-features --locked
cargo clippy --workspace --all-targets --all-features \
  --exclude niri-zvim-zellij --locked -- -D warnings
cargo clippy --package niri-zvim-zellij --target wasm32-wasip1 \
  --locked -- -D warnings

shellcheck -x \
  scripts/bench \
  scripts/bench-live \
  scripts/check \
  scripts/check-install \
  scripts/check-packages \
  scripts/install \
  scripts/lib/install.sh \
  scripts/package-release \
  scripts/release-check \
  scripts/release-notes \
  scripts/verify-release-bundle \
  scripts/test \
  scripts/test-live \
  scripts/test-output \
  scripts/live-tests/common/terminals.sh \
  scripts/live-tests/terminal-smoke.sh \
  tests/fixtures/terminal \
  tests/fixtures/zellij-attach \
  tests/fixtures/warning

scripts/check-install
scripts/check-packages
